ENV=development

# Timing
SAMPLE_INTERVAL_SECONDS=10
CONTROL_INTERVAL_SECONDS=10

# Prediction
HISTORY_WINDOW_MINUTES=60
STRESS_MOISTURE_THRESHOLD=350
PREEMPT_MINUTES=30

# Pump
PUMP_PULSE_SECONDS=3
PUMP_MIN_COOLDOWN_SECONDS=300

# Lighting
LIGHT_LUX_THRESHOLD=100

# Adaptive dosing
TARGET_BUFFER_ABOVE_STRESS=40
PUMP_MIN_PULSE_SECONDS=1
PUMP_MAX_PULSE_SECONDS=12

# Adaptive calibration
CALIBRATION_DELAY_SECONDS=300
CALIBRATION_ALPHA=0.2
MIN_CALIBRATION_DELTA=2.0

# Logging
LOG_DEBUG=true


TIMEZONE=America/New_York
WATERING_WINDOW_START_HOUR=7
WATERING_WINDOW_END_HOUR=22
EMERGENCY_MOISTURE_THRESHOLD=300
DAILY_IRRIGATION_BUDGET_SECONDS=120
MAX_IRRIGATION_PULSES_PER_HOUR=6
